# ==============================================================================
# AutoUGC Enterprise Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# In Staging and Production, configure these via your CI/CD, Vercel, AWS Secrets, or Kubernetes.

# ------------------------------------------------------------------------------
# 1. Core Application & Base URLs
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_VERSION=0.1.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000
LOG_LEVEL=info
STRUCTURED_LOGS=true

# ------------------------------------------------------------------------------
# 2. Database & Persistence (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (via PgBouncer) for application queries & serverless runtime:
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct unpooled connection string for Prisma DDL migrations & schema pushes:
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Authentication & User Management (Clerk)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_sample_clerk_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ------------------------------------------------------------------------------
# 4. Internal Security Cryptography & Microservice Secrets (AES-256 & HMAC)
# ------------------------------------------------------------------------------
SESSION_SECRET="super-secret-session-key-minimum-32-chars-long-for-aes-encryption"
AUTH_SECRET="autougc_session_secret_key_32chars_long!!"
ENCRYPTION_SECRET="autougc_dev_aes_secret_key_32bytes_long!!"
APPROVAL_SECRET="autougc_campaign_approval_secret_token_32chars"
CRON_SECRET="autougc_background_cron_bearer_secret_token"
DEVOPS_ROLLBACK_API_KEY="autougc_devops_canary_rollback_key"

# ------------------------------------------------------------------------------
# 5. AI Script Generation & Creative Intelligence (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini 1.5/2.0 API Key for autonomous viral hook and script angle generation:
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Talking Avatar & Lip-Sync Engines (Hedra, SyncLabs, Replicate)
# ------------------------------------------------------------------------------
# Hedra Character Generation API (Portrait video generation with lip motion):
HEDRA_API_KEY=""
# SyncLabs Lip-Sync API (Real-time video lip synchronization):
SYNCLABS_API_KEY=""
# Replicate API Token (Wav2Lip / SadTalker character animation):
REPLICATE_API_TOKEN=""

# ------------------------------------------------------------------------------
# 7. Production Video Cloud Rendering (Remotion AWS Lambda - For Multi-Hundred Concurrent Renders)
# ------------------------------------------------------------------------------
# When left blank, AutoUGC renders locally via background BullMQ worker queue (Zero Vercel timeouts).
# Configure these when scaling beyond 1,000+ daily exports using distributed AWS Lambda:
REMOTION_AWS_ACCESS_KEY_ID=""
REMOTION_AWS_SECRET_ACCESS_KEY=""
REMOTION_AWS_REGION="us-east-1"
REMOTION_FUNCTION_NAME="remotion-render-arm64"
REMOTION_SERVE_URL=""

# ------------------------------------------------------------------------------
# 8. Billing & Payments (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_sample_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_publishable_key
STRIPE_STARTER_PRICE_ID="price_starter_20_usd"
STRIPE_GROWTH_PRICE_ID="price_growth_55_usd"
STRIPE_SCALE_PRICE_ID="price_scale_139_usd"

# ------------------------------------------------------------------------------
# 9. Social Publishing OAuth Connections (TikTok, Instagram, YouTube)
# ------------------------------------------------------------------------------
# Leave blank to enable mock offline social distribution for testing:
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 10. Transactional Email & Notifications (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 11. Observability, APM & Error Tracking (Sentry, PostHog, Datadog)
# ------------------------------------------------------------------------------
# Sentry Crash & Error Reporting:
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# PostHog Product & Retention Analytics:
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_API_KEY=""
POSTHOG_PROJECT_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# Datadog APM & Metrics:
DATADOG_API_KEY=""
DATADOG_SITE="datadoghq.com"
DD_API_KEY=""
DD_SITE="datadoghq.com"
