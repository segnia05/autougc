# ==============================================================================
# AutoUGC Enterprise Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In Staging and Production, configure these via Kubernetes Secrets or Cloud KMS.

# Environment Designation (development | staging | production | test)
NODE_ENV=development
APP_ENV=development
APP_VERSION=0.1.0
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Database & Persistence (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (via PgBouncer) for application queries:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/autougc?sslmode=require"
# Direct connection string for Prisma migrations:
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/autougc?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication (Clerk Multi-Tenant)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# 3. Billing & Payments (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_sample_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_publishable_key

# ------------------------------------------------------------------------------
# 4. Intelligence Engine & AI (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sample_gemini_api_key

# ------------------------------------------------------------------------------
# 5. Observability & Telemetry (Sentry, PostHog, Datadog)
# ------------------------------------------------------------------------------
# Sentry Error Tracking DSN:
SENTRY_DSN=https://sample_key@o0.ingest.sentry.io/0000000
NEXT_PUBLIC_SENTRY_DSN=https://sample_key@o0.ingest.sentry.io/0000000

# PostHog Product Analytics:
NEXT_PUBLIC_POSTHOG_KEY=phc_sample_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Datadog APM & DogStatsD:
DATADOG_API_KEY=sample_datadog_api_key
DATADOG_SITE=datadoghq.com
DD_AGENT_HOST=localhost
DD_DOGSTATSD_PORT=8125

# ------------------------------------------------------------------------------
# 6. DevOps & Progressive Rollouts
# ------------------------------------------------------------------------------
# Percentage of traffic routed to canary deployment (0 to 100):
CANARY_PERCENTAGE=0
ENABLE_DEBUG_LOGS=false
