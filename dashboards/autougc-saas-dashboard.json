{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System RED Metrics (Rate, Errors, Duration)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(autougc_http_requests_total[1m])) by (route, status)",
          "legendFormat": "{{route}} [{{status}}]",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Throughput",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        {
          "expr": "(sum(rate(autougc_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(autougc_http_requests_total[5m]))) * 100",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ],
      "title": "HTTP Error Rate % (5xx)",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(autougc_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(autougc_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(autougc_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "API Request Latency Percentiles (p50, p95, p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "SaaS Creative Engine & Pipeline Throughput",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "autougc_videos_rendered_total",
          "legendFormat": "Rendered Videos",
          "refId": "A"
        }
      ],
      "title": "Total UGC Videos Produced",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "autougc_scripts_generated_total",
          "legendFormat": "Generated Scripts",
          "refId": "A"
        }
      ],
      "title": "Viral AI Scripts Generated",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 10 },
      "id": 6,
      "targets": [
        {
          "expr": "autougc_audio_synthesized_seconds_total",
          "legendFormat": "Audio Synthesized (s)",
          "refId": "A"
        }
      ],
      "title": "Neural Voiceover Synthesized (Seconds)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 10 },
      "id": 7,
      "targets": [
        {
          "expr": "autougc_credits_consumed_total",
          "legendFormat": "Credits Consumed",
          "refId": "A"
        }
      ],
      "title": "Atomic Credit Ledger Burn",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 300,
      "title": "Worker Queues, Memory & Runtime Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 8,
      "targets": [
        {
          "expr": "autougc_queue_jobs_active",
          "legendFormat": "Active In-Flight Jobs",
          "refId": "A"
        },
        {
          "expr": "rate(autougc_queue_jobs_total[1m])",
          "legendFormat": "Completed Jobs / Sec",
          "refId": "B"
        }
      ],
      "title": "Asynchronous Job Queue Depth & Throughput",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 9,
      "targets": [
        {
          "expr": "process_heap_bytes",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "expr": "process_rss_bytes",
          "legendFormat": "Resident Set Size (RSS)",
          "refId": "B"
        }
      ],
      "title": "Node.js Process Memory Footprint",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["autougc", "saas", "observability", "sentry", "posthog", "datadog", "grafana"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "AutoUGC Enterprise Observability & Operations",
  "version": 1
}
